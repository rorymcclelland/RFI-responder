{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project unit --coverage",
    "test:db": "vitest run --project db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "eval:retrieval": "tsx eval/run-retrieval.ts",
    "eval:calibrate": "tsx eval/run-calibration.ts",
    "eval:answerability": "tsx eval/run-answerability.ts",
    "eval:gates": "tsx eval/run-gates.ts",
    "eval:drafting": "tsx eval/run-drafting.ts",
    "eval:redteam": "tsx eval/run-redteam.ts",
    "eval:duplicates": "tsx eval/run-duplicates.ts",
    "eval:extraction": "tsx eval/run-extraction.ts",
    "eval:consistency": "tsx eval/run-consistency.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.344.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^22.19.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.18",
    "docx": "^9.14.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "pg": "^8.23.1",
    "postcss": "^8.4.35",
    "supabase": "^2.121.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
