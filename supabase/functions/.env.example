# Copy to supabase/functions/.env (ignored by git). Secrets for the Edge Functions,
# also read by the evaluation scripts. Never put these in the app's .env: anything
# there is built into the browser bundle.

# Which embedding provider the app uses: voyage (hosted) or ollama (local). Decision 0005.
# For ollama, set EMBEDDING_MODEL=qwen3-embedding:0.6b (decision 0006; the default when unset).
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
VOYAGE_API_KEY=

# Ollama as seen from inside Docker (Edge Functions). For EMBEDDING_PROVIDER=ollama.
OLLAMA_URL=http://host.docker.internal:11434
# Ollama as seen from your PC (evaluation scripts).
OLLAMA_URL_HOST=http://localhost:11434

# Drafting and the answerability check (Sprint 2). Server-side only; never put this in the app's .env.
ANTHROPIC_API_KEY=

# Answerability check (S2-1): claude-haiku-5-5 (needs ANTHROPIC_API_KEY), rerank-2.5 or
# rerank-3 (need VOYAGE_API_KEY), or none (falls back to Sprint 1's similarity calibration).
# The chosen combination needs a calibration table (npm run eval:calibrate).
ANSWERABILITY_CHECKER=claude-haiku-5-5
# Models for the pricing and legal classifier (S2-3) and for drafting (S2-2b).
GATE_MODEL=claude-haiku-5-5
DRAFT_MODEL=claude-haiku-5-5
# The model that finds questions in Word documents (S5).
EXTRACT_MODEL=claude-haiku-5-5
