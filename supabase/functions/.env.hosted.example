# Sprint 14: the Edge Function secrets for the hosted demo. Copy to supabase/functions/.env.hosted.local
# (ignored by git: *.local), fill in the two keys, then:
#   npx supabase secrets set --env-file supabase/functions/.env.hosted.local
# Use keys made for the demo, each with its own spend limit at the provider, not your local ones.
# Never put these in the app's .env or in Vercel: anything there can reach the browser.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-4
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
