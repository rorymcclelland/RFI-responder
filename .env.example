# Copy to .env and fill in. Never commit .env.
#
# Local development: run `npm run db:start`; the Supabase CLI prints both values
# ("API URL" and "anon key"). For a hosted project: Project Settings > API.
#
# The anon key is public by design (it ships in the browser bundle). Row-level
# security in supabase/migrations decides what each user can do with it.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Alternative for embedded browsers that block other local ports (see vite.config.ts):
# VITE_SUPABASE_URL=http://localhost:5173/supabase
VITE_SUPABASE_ANON_KEY=
